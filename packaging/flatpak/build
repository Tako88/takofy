#!/usr/bin/env bash
# Builds the Flatpak out of this working tree and leaves a bundle in .build/.
#
#   bash packaging/flatpak/build
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "$here/../.." && pwd)

manifest="$here/io.github.Tako88.Takofy.yml"
sources="$here/cargo-sources.json"
stamp="$here/cargo-sources.sha256"
build="$here/.build"
repo="$build/repo"
bundle="$build/io.github.Tako88.Takofy.flatpak"

# A crate set that no longer matches the lockfile fails deep inside the sandbox
# as a missing package, so it is refused here instead.
if [ ! -f "$stamp" ] || ! (cd "$root" && sha256sum --quiet --check "$stamp"); then
	echo "cargo-sources.json was not generated from this Cargo.lock; run:" >&2
	echo "  bash $here/sources" >&2
	exit 1
fi

mkdir -p "$build"
flatpak-builder \
	--user \
	--force-clean \
	--default-branch=stable \
	--repo="$repo" \
	--state-dir="$build/state" \
	"$build/app" "$manifest"

flatpak build-bundle \
	--runtime-repo=https://dl.flathub.org/repo/flathub.flatpakrepo \
	"$repo" "$bundle" io.github.Tako88.Takofy stable
echo "built $bundle"
