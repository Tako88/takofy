#!/usr/bin/env bash
# Installs the bundle `build` left behind, then runs it.
#
#   bash packaging/flatpak/install              install and launch
#   bash packaging/flatpak/install --no-run     install only
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
bundle="$here/.build/io.github.Tako88.Takofy.flatpak"

if [ ! -f "$bundle" ]; then
	echo "no bundle at $bundle; run: bash $here/build" >&2
	exit 1
fi

flatpak install --user --reinstall --noninteractive "$bundle"

if [ "${1-}" = "--no-run" ]; then
	exit 0
fi
exec flatpak run io.github.Tako88.Takofy
